---
# Rendered by scripts/deploy.sh from Bicep outputs. Do not hand-edit.
all:
  vars:
    ansible_user: {{ admin_username }}
    ansible_ssh_private_key_file: {{ ssh_private_key }}
    ansible_python_interpreter: /usr/bin/python3
    nats_public_fqdn: {{ nats_public_fqdn }}
    key_vault_name: {{ key_vault_name }}
    pfx_secret_name: {{ pfx_secret_name }}

  children:
    nats_servers:
      hosts:
{% for h in nats_servers %}
        {{ h.name }}:
          ansible_host: {{ h.public_ip }}
          nats_private_ip: {{ h.private_ip }}
          nats_node_index: {{ h.index }}
{% endfor %}

    nats_clients:
      hosts:
{% for h in nats_clients %}
        {{ h.name }}:
{% if h.public_ip %}
          ansible_host: {{ h.public_ip }}
{% else %}
          ansible_host: {{ h.private_ip }}
          ansible_ssh_common_args: '-o ProxyJump={{ admin_username }}@{{ nats_clients[0].public_ip }}'
{% endif %}
          nats_private_ip: {{ h.private_ip }}
          client_index: {{ h.index }}
{% endfor %}
